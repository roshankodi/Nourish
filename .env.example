# =====================================================================
# Nourish Sanctuary - Environment Configuration
# =====================================================================

# 1. Google Gemini AI API Key
# Obtain at: https://aistudio.google.com/app/apikey
# Required for: AI food plate recognition, macro extraction, and Sage nutrition chat
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Google Health API Key (Google Cloud Project)
# Obtain in Google Cloud Console Credentials
GOOGLE_HEALTH_API_KEY="your_google_health_api_key_here"

# 3. Google Cloud OAuth 2.0 Credentials
# Obtain at: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Authorized redirect URI in Google Cloud Console:
# Add http://localhost:3000/api/auth/google/callback to "Authorized redirect URIs"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 4. Google Health API Scope
# Scope requested during OAuth consent:
GOOGLE_HEALTH_SCOPE="https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly"

# 5. Host and Application URL
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"
